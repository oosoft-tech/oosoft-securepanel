{# nginx/templates/domain.conf.j2
   Phase 1 — HTTP-only vhost for static sites.
   Auto-generated by Oosoft SecurePanel.
   Replaced by domain-ssl.conf.j2 once an SSL certificate is provisioned. #}
server {
    listen      80;
    listen      [::]:80;
    server_name {{ domain }} www.{{ domain }};

    root  /var/www/{{ domain }};
    index index.html index.htm;

    access_log /var/log/nginx/{{ domain }}_access.log combined buffer=8k flush=5s;
    error_log  /var/log/nginx/{{ domain }}_error.log warn;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location ~ /\. { deny all; return 404; }
    location ~* (\.env|wp-config\.php|composer\.(json|lock)|\.git|package\.json) {
        deny all;
        return 404;
    }

    location / { try_files $uri $uri/ =404; }

    # ACME challenge — must be served over HTTP for Let's Encrypt issuance
    location /.well-known/acme-challenge/ {
        root         /var/www/letsencrypt;
        default_type "text/plain";
        try_files    $uri =404;
    }

    client_max_body_size 64M;
}
