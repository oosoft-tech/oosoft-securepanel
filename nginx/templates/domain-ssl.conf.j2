{# nginx/templates/domain-ssl.conf.j2
   Phase 2 — HTTPS vhost for static sites (HTTP→HTTPS redirect + TLS block).
   Auto-generated by Oosoft SecurePanel after SSL certificate issuance.
   Replaces domain.conf.j2 in /etc/nginx/conf.d/{{ domain }}.conf. #}

# ── HTTP: ACME passthrough + permanent redirect ───────────────────────────────
server {
    listen      80;
    listen      [::]:80;
    server_name {{ domain }} www.{{ domain }};

    # Keep serving the ACME challenge path so certbot can renew without
    # temporarily downgrading to HTTP-only.
    location /.well-known/acme-challenge/ {
        root         /var/www/letsencrypt;
        default_type "text/plain";
        try_files    $uri =404;
    }

    # Redirect both apex and www→HTTPS apex (canonical: no www).
    location / {
        return 301 https://{{ domain }}$request_uri;
    }
}

# ── HTTPS ─────────────────────────────────────────────────────────────────────
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name {{ domain }};

    # Certificates managed by certbot (renewed by certbot-renewal.timer).
    ssl_certificate         /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{ domain }}/chain.pem;

    # Shared TLS hardening — Mozilla Modern (TLS 1.2/1.3, ECDHE, OCSP stapling,
    # HSTS, security headers).  Installed by ssl-setup.sh.
    include /etc/nginx/snippets/ssl-params.conf;

    root  /var/www/{{ domain }};
    index index.html index.htm;

    access_log /var/log/nginx/{{ domain }}_access.log combined buffer=8k flush=5s;
    error_log  /var/log/nginx/{{ domain }}_error.log warn;

    # Per-site security headers (ssl-params.conf adds HSTS + Permissions-Policy)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location ~ /\. { deny all; return 404; }
    location ~* (\.env|wp-config\.php|composer\.(json|lock)|\.git|package\.json) {
        deny all;
        return 404;
    }

    location / { try_files $uri $uri/ =404; }

    client_max_body_size 64M;
}
