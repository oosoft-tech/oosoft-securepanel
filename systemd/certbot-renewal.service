[Unit]
Description=Certbot Certificate Renewal — Oosoft SecurePanel
Documentation=https://certbot.eff.org/docs/
# Require network to be up before attempting renewal.
After=network-online.target
Wants=network-online.target
# Do not run while nginx is being restarted.
After=nginx.service

[Service]
Type=oneshot
User=root

# Run certbot renew for all certificates.
# --quiet:           suppress output unless there is an error or renewal occurs.
# --no-random-sleep: timer unit adds its own randomised delay (RandomizedDelaySec).
ExecStart=/usr/bin/certbot renew \
    --quiet \
    --no-random-sleep \
    --deploy-hook /etc/letsencrypt/renewal-hooks/post/reload-nginx.sh

# Harden the service unit itself.
# certbot still needs CAP_NET_BIND_SERVICE if it uses the standalone plugin,
# but we use --webroot so no special capabilities are required.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/etc/letsencrypt /var/log/letsencrypt /var/www/letsencrypt

# Log to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=certbot-renewal

[Install]
WantedBy=multi-user.target
