# Copy to .env and fill in values before starting
APP_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET

ALLOWED_HOSTS=["panel.example.com"]
CORS_ORIGINS=["https://panel.example.com"]

DATABASE_URL=postgresql+asyncpg://securepanel:DBPASSWORD@127.0.0.1:5432/securepanel

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

MAIL_DOMAIN=example.com

# Optional: AI assistant features
ANTHROPIC_API_KEY=

# MySQL root/admin password for database management
DB_ADMIN_PASSWORD=CHANGE_ME
